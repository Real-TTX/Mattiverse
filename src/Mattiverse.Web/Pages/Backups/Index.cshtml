@page
@model Mattiverse.Web.Pages.Backups.IndexModel
@{
    ViewData["Title"] = "Backups";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Backups</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (Model.MatDockSilent)
{
    <div class="alert alert--warning"><icon name="alert" /><span>MatDock does not answer right now, so its backups and schedules are not listed. They are safe in MatDock.</span></div>
}

<tab-bar model="Model.Tabs" />

@if (Model.SchedulesTab)
{
    <mat-table>
        <mat-table-body>
            @if (Model.Schedules.Count == 0)
            {
                <div class="empty-state"><div><icon name="calendar" /></div><p>No schedules yet. A schedule backs up your apps automatically and keeps the newest copies.</p></div>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>Schedule</th><th>Apps</th><th>When</th><th class="hide-sm">Keeps</th><th class="hide-sm">Last run</th><th class="actions"></th></tr></thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Backups/ScheduleEdit" asp-route-id="@schedule.Id"><strong>@schedule.Name</strong></a>
                                    <span class="mat-badge" style="margin-left:6px;" title="Where this schedule runs">@IndexModel.EngineLabel(schedule.Engine)</span>
                                    @if (!schedule.Enabled)
                                    {
                                        <span class="pill pill--unknown" style="margin-left:6px;">Off</span>
                                    }
                                </td>
                                <td>@Model.AppNameOf(schedule.AppSlug)</td>
                                <td class="nowrap">
                                    @(schedule.Frequency == BackupFrequency.Daily ? "Daily" : $"Weekly, {schedule.Weekday}") at @TimeSpan.FromMinutes(schedule.MinuteOfDay).ToString(@"hh\:mm")
                                </td>
                                <td class="nowrap hide-sm">@schedule.Retention backups</td>
                                <td class="text-muted hide-sm">@(schedule.LastStatus ?? "not yet")</td>
                                <td class="actions">
                                    <div class="row-actions">
                                        <a class="mat-btn mat-btn--sm mat-btn--icon mat-btn--ghost" asp-page="/Backups/ScheduleEdit" asp-route-id="@schedule.Id" title="Edit"><icon name="edit" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </mat-table-body>
        <mat-table-actions>
            <a href="/Backups/ScheduleEdit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New schedule</span></a>
        </mat-table-actions>
    </mat-table>
}
else
{
    <mat-table>
        <mat-table-toolbar>
            <form method="get" class="js-autosubmit">
                <div class="search">
                    <icon name="search" />
                    <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search…" aria-label="Search" />
                </div>
                <div class="toolbar-field">
                    <label for="app">App</label>
                    <select id="app" name="App" class="mat-select">
                        <option value="">All</option>
                        @foreach (var slug in Model.AppSlugs)
                        {
                            <option value="@slug" selected="@(Model.App == slug)">@slug</option>
                        }
                    </select>
                </div>
                <div class="toolbar-field">
                    <label for="kind">Kind</label>
                    <select id="kind" name="Kind" class="mat-select">
                        <option value="">All</option>
                        @foreach (var kind in Enum.GetValues<BackupKind>())
                        {
                            <option value="@kind" selected="@(Model.Kind == kind.ToString())">@kind</option>
                        }
                    </select>
                </div>
                <div class="toolbar-field">
                    <label for="sort">Sort</label>
                    <select id="sort" name="SortKey" class="mat-select">
                        <option value="NewestFirst" selected="@(Model.SortKey == "NewestFirst")">Newest first</option>
                        <option value="OldestFirst" selected="@(Model.SortKey == "OldestFirst")">Oldest first</option>
                        <option value="Largest" selected="@(Model.SortKey == "Largest")">Largest first</option>
                        <option value="App" selected="@(Model.SortKey == "App")">A–Z: App</option>
                    </select>
                </div>
            </form>
        </mat-table-toolbar>

        <mat-table-body>
            @if (Model.Items.Count == 0)
            {
                <div class="empty-state"><div><icon name="save" /></div><p>No backups yet.</p></div>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>App</th><th>Created</th><th class="hide-sm">Kind</th><th class="hide-sm">Size</th><th>Status</th><th class="actions"></th></tr></thead>
                    <tbody>
                        @foreach (var backup in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <app-icon name="@backup.AppName" icon="@Model.IconOf(backup.CatalogId)" size="sm" />
                                        <span><strong>@backup.AppName</strong>@if (!string.IsNullOrEmpty(backup.Note)) {<small>@backup.Note</small>}</span>
                                    </div>
                                </td>
                                <td class="nowrap">@Format.DateTimeLocal(backup.CreatedUtc)<br /><small class="text-muted">@Format.Ago(backup.CreatedUtc)</small></td>
                                <td class="hide-sm"><span class="mat-badge">@backup.Kind</span> <span class="mat-badge" title="Where this backup is kept">@IndexModel.EngineLabel(backup.Engine)</span></td>
                                <td class="nowrap hide-sm">@Format.Size(backup.SizeBytes)<br /><small class="text-muted">@backup.VolumeCount volume@(backup.VolumeCount == 1 ? "" : "s")</small></td>
                                <td>
                                    <span class="pill pill--@(backup.Status == BackupStatus.Succeeded ? "online" : backup.Status == BackupStatus.Failed ? "offline" : "busy")" title="@backup.Error">@backup.Status</span>
                                    @if (backup.Status == BackupStatus.Succeeded && !backup.Consistent)
                                    {
                                        <br /><small class="text-muted" title="The app was running while its data was copied.">live copy</small>
                                    }
                                </td>
                                <td class="actions">
                                    <div class="row-actions">
                                        @if (backup.Status == BackupStatus.Succeeded)
                                        {
                                            <a class="mat-btn mat-btn--sm" asp-page="/Backups/Restore" asp-route-id="@backup.Id" title="Restore"><icon name="restore" /><span>Restore</span></a>
                                            <a class="mat-btn mat-btn--sm mat-btn--icon mat-btn--ghost" asp-page="/Backups/Index" asp-page-handler="Download" asp-route-id="@backup.Id" title="Download as tar"><icon name="download" /></a>
                                        }
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@backup.Id" class="inline-form" data-confirm="Delete this backup? Its files are removed." data-confirm-ok="Delete" data-confirm-danger>
                                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--icon mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </mat-table-body>

        <mat-table-pagination>
            <pagination model="Model.Pagination" />
        </mat-table-pagination>

        <mat-table-actions>
            <a href="/Backups/Create" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New backup</span></a>
            <span class="text-muted" style="margin-left:auto;">@Format.Size(Model.TotalSize) in total</span>
        </mat-table-actions>
    </mat-table>
}
