@page
@model Mattiverse.Web.Pages.Backups.RestoreModel
@{
    var backup = Model.Backup;
    ViewData["Title"] = $"Restore {backup.AppName}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Restore @backup.AppName</h1>
    </div>
</div>

<div class="stack" style="max-width:640px;">
    <div class="card">
        <div class="card__header"><icon name="save" /><span>The backup</span></div>
        <div class="card__body">
            <dl class="kv">
                <dt>Created</dt><dd>@Format.DateTimeLocal(backup.CreateDate) <span class="text-muted">· @Format.Ago(backup.CreateDate)</span></dd>
                <dt>Kind</dt><dd><span class="mat-badge">@backup.Kind</span> @backup.Note</dd>
                <dt>Content</dt><dd>@backup.VolumeCount volume@(backup.VolumeCount == 1 ? "" : "s"), @Format.Size(backup.SizeBytes)</dd>
                <dt>Copy</dt><dd>@(backup.Consistent ? "Taken while the app was stopped (consistent)." : "Taken from the running app (a live copy).")</dd>
            </dl>
        </div>
    </div>

    <div class="alert alert--warning" style="margin:0;">
        <icon name="alert" />
        <span>
            @if (Model.App is null)
            {
                <text>The app is not installed any more. It is re-created with the settings and data of this backup.</text>
            }
            else
            {
                <text>The current data of <strong>@Model.App.Name</strong> is replaced by the data of this backup, and its containers are re-created.</text>
            }
        </span>
    </div>

    <div class="card">
        <div class="card__body">
            <form method="post" asp-route-id="@backup.Id" class="mat-form">
                @if (Model.App is not null)
                {
                    <label class="mat-switch">
                        <input asp-for="BackupFirst" type="checkbox" />
                        <span>Save the current state as a backup first</span>
                    </label>
                }

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--solid-danger"><icon name="restore" /><span>Restore</span></button>
                    <a href="/Backups" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                </mat-form-buttons>
            </form>
        </div>
    </div>
</div>
