@page
@model Mattiverse.Web.Pages.Apps.UpdateModel
@{
    ViewData["Title"] = $"Update {Model.App.Name}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Update @Model.App.Name</h1>
    </div>
</div>

<div class="card" style="max-width:640px;">
    <div class="card__body">
        <p>
            Mattiverse pulls the newest images of the app. If an image changed, the containers are re-created from it; your data in the volumes stays.
            If nothing is newer, nothing is restarted.
        </p>
        <form method="post" asp-route-id="@Model.App.Id" class="mat-form">
            <label class="mat-switch">
                <input asp-for="BackupFirst" type="checkbox" />
                <span>Back up first (recommended, so you can go back if the update goes wrong)</span>
            </label>

            <mat-form-buttons>
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="arrow-up" /><span>Update</span></button>
                <a href="/Apps/Details?id=@Model.App.Id" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
