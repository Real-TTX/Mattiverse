@page
@model Mattiverse.Web.Pages.Apps.UpdateModel
@{
    ViewData["Title"] = $"Update {Model.App.Name}";
    ViewData["PageSub"] = "Pulls the newest images of the app.";
    ViewData["Crumbs"] = Crumbs.Of(("Apps", "/Apps"), (Model.App.Name, $"/Apps/Details?id={Model.App.Id}"), ("Update", null));
    ViewData["Width"] = "narrow";
}

<p>
    Mattiverse pulls the newest images of the app. If an image changed, the containers are re-created from it; your data in the volumes stays.
    If nothing is newer, nothing is restarted.
</p>

<form method="post" asp-route-id="@Model.App.Id" class="mat-form" novalidate>
    <div class="mat-card">
        <div class="mat-card__body">
            <label class="mat-check">
                <input asp-for="BackupFirst" type="checkbox" />
                <span class="mat-check__text">Back up first (recommended, so you can go back if the update goes wrong)</span>
            </label>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="arrow-up" /><span>Update</span></button>
        <a href="/Apps/Details?id=@Model.App.Id" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
    </div>
</form>
