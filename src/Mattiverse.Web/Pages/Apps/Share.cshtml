@page
@model Mattiverse.Web.Pages.Apps.ShareModel
@{
    ViewData["Title"] = $"Share {Model.App.Name}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Share @Model.App.Name</h1>
    </div>
</div>

<div class="card" style="max-width:640px;">
    <div class="card__body">
        <p>
            Anyone with the link can open a page for this app, without an account. The link only leads to this one app; revoke it any time on the Sharing tab.
            The app's own login still applies.
        </p>
        <form method="post" asp-route-id="@Model.App.Id" class="mat-form">
            <div class="form-grid">
                <mat-field label="Label" asp-for="Label" hint="So you remember who has the link.">
                    <input asp-for="Label" class="mat-input" placeholder="For the family" />
                </mat-field>
                <mat-field label="Expires" asp-for="ExpiresInDays">
                    <select asp-for="ExpiresInDays" class="mat-select">
                        <option value="1">After 1 day</option>
                        <option value="7">After 7 days</option>
                        <option value="30">After 30 days</option>
                        <option value="0">Never</option>
                    </select>
                </mat-field>
            </div>

            <mat-form-buttons>
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="link" /><span>Create link</span></button>
                <a href="/Apps/Details?id=@Model.App.Id&tab=sharing" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
