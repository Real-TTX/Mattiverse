@page
@model Mattiverse.Web.Pages.Apps.UninstallModel
@{
    ViewData["Title"] = $"Uninstall {Model.App.Name}";
    ViewData["PageSub"] = "Removes the containers of the app.";
    ViewData["Crumbs"] = Crumbs.Of(("Apps", "/Apps"), (Model.App.Name, $"/Apps/Details?id={Model.App.Id}"), ("Uninstall", null));
    ViewData["Width"] = "narrow";
}

<p>
    The containers of the app are stopped and removed. By default its <strong>data is kept</strong> in the Docker volumes,
    so installing the app again picks it up where it was.
</p>

<form method="post" asp-route-id="@Model.App.Id" class="mat-form" novalidate>
    <div class="mat-card">
        <div class="mat-card__body mat-stack">
            <label class="mat-check">
                <input asp-for="DeleteData" type="checkbox" />
                <span class="mat-check__text">Also delete the data (the volumes)</span>
            </label>

            <div class="mat-stack" data-show-if="#DeleteData" data-show-value="true" hidden>
                <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">The data of the app is deleted for good.</div></div>
                <label class="mat-check">
                    <input asp-for="BackupFirst" type="checkbox" />
                    <span class="mat-check__text">Create a final backup first</span>
                </label>
            </div>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Uninstall @Model.App.Name? Its containers are removed." data-confirm-ok="Uninstall"><icon name="trash" /><span>Uninstall</span></button>
        <a href="/Apps/Details?id=@Model.App.Id" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
    </div>
</form>
