@page
@model Mattiverse.Web.Pages.Settings.SystemModel
@{
    ViewData["Title"] = "System";
    ViewData["PageSub"] = "Docker, the data folder and the version of Mattiverse.";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", "/Settings"), ("System", null));
    ViewData["Width"] = "narrow";
}

<div class="mat-card">
    <div class="mat-card__head"><icon name="whale" /><span class="mat-card__title">Docker</span></div>
    <div class="mat-card__body">
        @if (Model.Engine.Available)
        {
            <dl class="mat-kv">
                <dt>Status</dt><dd><span class="mat-pill mat-pill--ok">Connected</span></dd>
                <dt>Engine</dt><dd>Docker @Model.Engine.Version on @Model.Engine.OperatingSystem</dd>
                <dt>Resources</dt><dd>@Model.Engine.Cpus CPUs, @Format.Size(Model.Engine.MemoryBytes) memory</dd>
                <dt>Containers</dt><dd>@Model.Engine.ContainersRunning running of @Model.Engine.ContainersTotal, @Model.Engine.Images images</dd>
                <dt>Shared network</dt><dd><code>@Model.Network</code> <span class="mat-muted">connects the reverse proxy and the apps' web interfaces</span></dd>
                <dt>This container</dt><dd>@(Model.SelfContainer is null ? "not running in Docker" : Model.SelfContainer)</dd>
            </dl>
        }
        else
        {
            <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.Engine.Error</div></div>
        }
    </div>
</div>

<div class="mat-card">
    <div class="mat-card__head"><icon name="info" /><span class="mat-card__title">Mattiverse</span></div>
    <div class="mat-card__body">
        <dl class="mat-kv">
            <dt>Version</dt><dd><code>@Model.Version</code></dd>
            <dt>Data folder</dt><dd><code>@Model.DataPath</code> <span class="mat-muted">database, settings, compose files of the apps, backups</span></dd>
            <dt>Catalog</dt><dd>@Model.CatalogTotal apps@(Model.CatalogCustom > 0 ? $" ({Model.CatalogCustom} of your own)" : "")</dd>
            <dt>Reverse proxy</dt><dd>@(Model.ProxyActive ? "Matcad creates a route for every app." : "No automatic routes (needs Matcad and a domain for your apps).")</dd>
        </dl>
    </div>
</div>
