@page
@model Mattiverse.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["PageSub"] = "Names, addresses, the DNS account and the defaults of the backups.";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", null));
    ViewData["Width"] = "narrow";
}

<form method="post" class="mat-form" novalidate>
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><icon name="globe" /><span class="mat-card__title">Addresses</span></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Input.InstanceName" required="true" full="true" hint="Shown on the home screen, in the menu and in the browser tab.">
                    <input asp-for="Input.InstanceName" class="mat-input" required maxlength="60" data-msg-required="Please enter a name." />
                </mat-field>
                <mat-field label="Address of this machine" asp-for="Input.PublicHost" hint="How you reach this host, like nas.local or 192.168.1.20. Empty: whatever the browser used.">
                    <input asp-for="Input.PublicHost" class="mat-input" placeholder="nas.local" inputmode="url" autocomplete="off" />
                </mat-field>
                <mat-field label="Domain for your apps" asp-for="Input.BaseDomain" hint="Every app gets app.example.com, with a certificate from Matcad. Empty: apps use their port.">
                    <input asp-for="Input.BaseDomain" class="mat-input" placeholder="example.com" inputmode="url" autocomplete="off" />
                </mat-field>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="route" /><span class="mat-card__title">DNS account</span></div>
        <div class="mat-card__body">
            <partial name="_DnsFields" model="Model.Dns" />
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="save" /><span class="mat-card__title">Backup defaults</span></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mat-field label="Keep the newest" asp-for="Input.BackupRetention" hint="For new schedules.">
                    <input asp-for="Input.BackupRetention" type="number" min="1" max="365" class="mat-input" data-msg-range="Keep between 1 and 365 backups." />
                </mat-field>
                <div class="mat-field">
                    <span class="mat-label">While a backup runs</span>
                    <label class="mat-check">
                        <input asp-for="Input.BackupStopContainers" type="checkbox" />
                        <span class="mat-check__text">Stop apps while their data is copied</span>
                    </label>
                    <span class="mat-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
    </div>
</form>
