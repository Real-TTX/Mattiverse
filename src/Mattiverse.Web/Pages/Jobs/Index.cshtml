@page
@model Mattiverse.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Activity";
    ViewData["PageSub"] = "Installs, updates and backups, and how they went.";
    ViewData["Crumbs"] = Crumbs.Of(("Activity", null));
    var list = Model.List;
}

<div class="mat-list" @(Model.Busy ? "data-autorefresh=4000" : "")>
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="activity" /></span>
            @if (list.Filtered)
            {
                <div class="mat-empty__title">Nothing matches</div>
                <p>Change the search or the filter.</p>
                <a class="mat-btn mat-btn--secondary" href="/Jobs">Reset the tools</a>
            }
            else
            {
                <div class="mat-empty__title">Nothing happened yet</div>
                <p>Installs, updates and backups show up here.</p>
            }
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Activity</caption>
                <thead>
                    <tr><th scope="col">Task</th><th scope="col">Status</th><th scope="col" class="mat-hide-sm">Started</th><th scope="col" class="mat-hide-sm">Duration</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var job in list.Items)
                    {
                        var pill = job.Status switch
                        {
                            JobStatus.Succeeded => "mat-pill--ok",
                            JobStatus.Failed => "mat-pill--error",
                            _ => "mat-pill--busy",
                        };
                        <tr>
                            <td data-label="Task"><div class="mat-table__name"><a href="/Jobs/Details?id=@job.Id">@job.Title</a></div></td>
                            <td data-label="Status"><span class="mat-pill @pill">@(job.Status == JobStatus.Succeeded ? "Done" : job.Status.ToString())</span></td>
                            <td data-label="Started" class="mat-hide-sm mat-muted mat-nowrap">@Format.Ago(job.StartedAt ?? job.CreateDate)</td>
                            <td data-label="Duration" class="mat-hide-sm mat-muted mat-nowrap mat-mono">@Format.Duration(job.StartedAt, job.FinishedAt)</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Jobs/Details?id=@job.Id" aria-label="Show the log of @job.Title" data-tip="Show the log"><icon name="terminal" /></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" model="list.Pager" />
</div>
