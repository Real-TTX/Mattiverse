@page
@model Mattiverse.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Activity";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Activity</h1>
    </div>
</div>

<div @(Model.Busy ? "data-autorefresh=4000" : "")>
<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search…" aria-label="Search" />
            </div>
            <div class="toolbar-field">
                <label for="status">Status</label>
                <select id="status" name="Status" class="mat-select">
                    <option value="">All</option>
                    @foreach (var status in Enum.GetValues<JobStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status.ToString())">@status</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="sort">Sort</label>
                <select id="sort" name="SortKey" class="mat-select">
                    <option value="NewestFirst" selected="@(Model.SortKey == "NewestFirst")">Newest first</option>
                    <option value="OldestFirst" selected="@(Model.SortKey == "OldestFirst")">Oldest first</option>
                </select>
            </div>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><div><icon name="activity" /></div><p>Nothing happened yet. Installs, updates and backups show up here.</p></div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr><th>Task</th><th>Status</th><th>Started</th><th>Duration</th><th class="actions"></th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Items)
                    {
                        var css = job.Status switch
                        {
                            JobStatus.Succeeded => "online",
                            JobStatus.Failed => "offline",
                            _ => "busy",
                        };
                        <tr>
                            <td><a href="/Jobs/Details?id=@job.Id"><strong>@job.Title</strong></a></td>
                            <td><span class="pill pill--@css">@(job.Status == JobStatus.Succeeded ? "Done" : job.Status.ToString())</span></td>
                            <td class="text-muted nowrap">@Format.Ago(job.StartedAt ?? job.CreateDate)</td>
                            <td class="text-muted nowrap">@Format.Duration(job.StartedAt, job.FinishedAt)</td>
                            <td class="actions">
                                <a class="mat-btn mat-btn--sm mat-btn--icon mat-btn--ghost" href="/Jobs/Details?id=@job.Id" title="Show the log"><icon name="terminal" /></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>
</mat-table>
</div>
