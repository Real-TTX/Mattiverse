@page
@model Mattiverse.Web.Pages.People.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? Model.Person!.DisplayName : "New person";
    ViewData["PageSub"] = Model.IsEdit ? "Who they are, and what they may do in the apps." : "MatIdentity sends an invitation, or the person signs in with a starting password.";
    ViewData["Crumbs"] = Crumbs.Of(("People", "/People"), (Model.IsEdit ? Model.Person!.DisplayName : "New person", null));
    ViewData["Width"] = "narrow";
    var pwHint = Model.IsEdit ? "Leave blank to keep the password." : "Leave blank to send an invitation to the e-mail address.";
}

<form method="post" asp-route-id="@Model.Id" class="mat-form" novalidate>
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><icon name="user" /><span class="mat-card__title">Person</span></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Input.DisplayName" required="true">
                    <input asp-for="Input.DisplayName" class="mat-input" required data-msg-required="Please enter a name." />
                </mat-field>

                <mat-field label="User name" asp-for="Input.UserName" required="true">
                    <input asp-for="Input.UserName" class="mat-input" autocomplete="off" required data-msg-required="Please enter a user name." />
                </mat-field>

                <mat-field label="E-mail" asp-for="Input.Email">
                    <input asp-for="Input.Email" type="email" class="mat-input" autocomplete="off" />
                </mat-field>

                <div class="mat-field">
                    <span class="mat-label">Account</span>
                    <label class="mat-check">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span class="mat-check__text">Active: may sign in</span>
                    </label>
                    <label class="mat-check">
                        <input asp-for="Input.Administrator" type="checkbox" />
                        <span class="mat-check__text">Administrator of MatIdentity: may use every app, with its first role</span>
                    </label>
                </div>

                <mat-field label="Password" asp-for="Input.Password" hint="@pwHint">
                    <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>

                <mat-field label="Confirm password" asp-for="Input.ConfirmPassword">
                    <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            @if (Model.Groups.Count > 0)
            {
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">Groups</legend>
                    <div class="mat-options">
                        @foreach (var g in Model.Groups)
                        {
                            <label class="mat-check">
                                <input type="checkbox" name="Input.GroupIds" value="@g.Id" checked="@Model.Input.GroupIds.Contains(g.Id)" />
                                <span class="mat-check__text">@g.Name</span>
                            </label>
                        }
                    </div>
                    <span class="mat-hint">A group gives its apps to all its members.</span>
                </fieldset>
            }
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <a href="/People" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
        @if (Model.IsEdit)
        {
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" asp-route-id="@Model.Id" formnovalidate
                    data-confirm="Delete @Model.Person!.DisplayName? They are signed out of every app and can no longer sign in." data-confirm-ok="Delete" data-confirm-danger><icon name="trash" /><span>Delete</span></button>
        }
    </div>
</form>

@if (Model.Person is { } person)
{
    <div class="mat-card">
        <div class="mat-card__head"><icon name="apps" /><span class="mat-card__title">Apps</span></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">What @person.DisplayName may use, and with which role, rights and quotas. A change reaches the app at once: the person is signed in again there with the new values.</p>
            @if (Model.Apps.Count == 0)
            {
                <p class="mat-hint">No app signs in through MatIdentity yet.</p>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">Apps of @person.DisplayName</caption>
                        <thead><tr><th scope="col">App</th><th scope="col">Access</th><th scope="col">Role</th><th scope="col" class="mat-hide-sm">Rights and quotas</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var app in Model.Apps)
                            {
                                var access = person.Access.FirstOrDefault(a => a.App == app.ClientId);
                                <tr>
                                    <td data-label="App"><span class="mat-table__name">@app.Name</span></td>
                                    <td data-label="Access">
                                        @if (access is null)
                                        {
                                            <span class="mat-pill">No</span>
                                        }
                                        else
                                        {
                                            <span class="mat-pill mat-pill--ok">Yes</span> <span class="mat-muted">@Mattiverse.Web.Pages.People.EditModel.HowIn(access)</span>
                                        }
                                    </td>
                                    <td data-label="Role">@(access?.Role is { } role ? app.Roles.FirstOrDefault(r => r.Key == role)?.Label ?? role : app.RolesByIdentity ? "–" : "The app decides")</td>
                                    <td data-label="Rights and quotas" class="mat-hide-sm">@(access is null ? "–" : Mattiverse.Web.Pages.People.EditModel.Summary(app, access))</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/People/Access?person=@Uri.EscapeDataString(person.Subject)&amp;app=@Uri.EscapeDataString(app.ClientId)"
                                               aria-label="@app.Name for @person.DisplayName" data-tip="Change"><icon name="sliders" /></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="wrench" /><span class="mat-card__title">Account</span></div>
        <div class="mat-card__body">
            <div class="mat-btn-row mat-btn-row--plain">
                @foreach (var (action, label, icon, confirm) in Mattiverse.Web.Pages.People.EditModel.Actions)
                {
                    @if (confirm is null)
                    {
                        <form method="post" asp-page-handler="Action" asp-route-id="@Model.Id">
                            <input type="hidden" name="action" value="@action" />
                            <button type="submit" class="mat-btn mat-btn--secondary"><icon name="@icon" /><span>@label</span></button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Action" asp-route-id="@Model.Id" data-confirm="@confirm" data-confirm-ok="@label">
                            <input type="hidden" name="action" value="@action" />
                            <button type="submit" class="mat-btn mat-btn--secondary"><icon name="@icon" /><span>@label</span></button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
}
