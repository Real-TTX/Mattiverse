@page
@model Mattiverse.Web.Pages.People.GroupsModel
@{
    ViewData["Title"] = "Groups";
    ViewData["PageSub"] = "A group gives its apps, with a role, rights and quotas, to all its members.";
    ViewData["Crumbs"] = Crumbs.Of(("People", "/People"), ("Groups", null));
}

<tab-bar model="Model.Tabs" label="People" />

@if (!Model.Available)
{
    <div class="mat-empty">
        <span class="mat-empty__icon"><icon name="layers" /></span>
        <div class="mat-empty__title">Groups need MatIdentity</div>
        <p>MatIdentity keeps the people and groups of all apps.</p>
        <a class="mat-btn mat-btn--primary" href="/Store"><icon name="store" /><span>Open the Store</span></a>
    </div>
}
else if (Model.Problem is not null)
{
    <div class="mat-alert mat-alert--error" role="alert"><icon name="alert" /><div class="mat-alert__body">MatIdentity could not be read: @Model.Problem</div></div>
}
else
{
    <div class="mat-list">
        @if (Model.Groups.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon"><icon name="layers" /></span>
                <div class="mat-empty__title">No groups yet</div>
                <p>A group (family, guests, a team) gives apps to all its members at once.</p>
                <a class="mat-btn mat-btn--secondary" href="/People/Group">New group</a>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Groups</caption>
                    <thead><tr><th scope="col">Group</th><th scope="col">Members</th><th scope="col">Apps</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var g in Model.Groups)
                        {
                            <tr>
                                <td data-label="Group"><div class="mat-table__name"><a href="/People/Group?id=@Uri.EscapeDataString(g.Id)">@g.Name</a></div></td>
                                <td data-label="Members">@g.Members.Count</td>
                                <td data-label="Apps">@(g.Grants.Count == 0 ? "–" : string.Join(", ", g.Grants.Select(x => Model.AppNames.GetValueOrDefault(x.App, x.App))))</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/People/Group?id=@Uri.EscapeDataString(g.Id)" aria-label="Edit @g.Name" data-tip="Edit"><icon name="edit" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mat-actions">
            <a href="/People/Group" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New group</span></a>
        </div>
    </div>
}
