@page
@model Mattiverse.Web.Pages.Wizard.ProgressModel
@{
    ViewData["Title"] = Model.Finished ? (Model.AnyFailed ? "Done, with a problem" : "All set") : "Setting things up";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", "/Settings"), ("Setup wizard", "/Wizard"), ("Progress", null));
    ViewData["Width"] = "narrow";
    ViewData["PageSub"] = !Model.Finished
        ? "This takes a minute or two: images are downloaded and the apps started. You can leave this page; the work continues."
        : Model.AnyFailed
            ? "Something did not work out. Open the failed step for the log, fix the cause and install it again from the store."
            : "Everything is installed. Open the apps from your home screen.";
}

<div class="mat-stack" @(Model.Finished ? "" : "data-autorefresh=3000")>
    <ul class="mat-listgroup">
        @foreach (var job in Model.Jobs)
        {
            var pill = job.Status switch { JobStatus.Succeeded => "mat-pill--ok", JobStatus.Failed => "mat-pill--error", _ => "mat-pill--busy" };
            <li>
                <a class="mat-listgroup__item" href="/Jobs/Details?id=@job.Id">
                    <span class="mat-listgroup__text"><strong>@job.Title</strong></span>
                    <span class="mat-pill @pill">@(job.Status == JobStatus.Succeeded ? "Done" : job.Status.ToString())</span>
                </a>
            </li>
        }
    </ul>

    <div class="mat-btn-row mat-btn-row--plain">
        <a href="/" class="mat-btn mat-btn--primary @(Model.Finished ? "" : "is-disabled")" aria-disabled="@(Model.Finished ? null : "true")"><icon name="home" /><span>Go to Home</span></a>
        <a href="/Jobs" class="mat-btn mat-btn--ghost"><icon name="activity" /><span>Activity</span></a>
    </div>
</div>
