@page
@model Mattiverse.Web.Pages.Wizard.ProgressModel
@{
    ViewData["Title"] = "Setup";
}

<div class="wizard" @(Model.Finished ? "" : "data-autorefresh=3000")>
    <div class="wizard__hero">
        <img src="~/img/logo.svg" width="72" height="72" alt="" />
        <h1>@(Model.Finished ? (Model.AnyFailed ? "Done, with a problem" : "All set") : "Setting things up …")</h1>
        <p>
            @if (!Model.Finished)
            {
                <text>This takes a minute or two: images are downloaded and the apps started. You can leave this page; the work continues.</text>
            }
            else if (Model.AnyFailed)
            {
                <text>Something did not work out. Open the failed step for the log, fix the cause and install it again from the store.</text>
            }
            else
            {
                <text>Everything is installed. Open the apps from your home screen.</text>
            }
        </p>
    </div>

    <ul class="progress-steps">
        @foreach (var job in Model.Jobs)
        {
            var css = job.Status switch { JobStatus.Succeeded => "online", JobStatus.Failed => "offline", _ => "busy" };
            <li onclick="location.href='/Jobs/Details?id=@job.Id'">
                <strong>@job.Title</strong>
                <span class="state"><span class="pill pill--@css">@(job.Status == JobStatus.Succeeded ? "Done" : job.Status.ToString())</span></span>
            </li>
        }
    </ul>

    <div class="wizard__nav">
        <a href="/Jobs" class="mat-btn mat-btn--ghost"><icon name="activity" /><span>Activity</span></a>
        <span class="mat-buttons__spacer"></span>
        <a href="/" class="mat-btn mat-btn--primary @(Model.Finished ? "" : "is-disabled")"><icon name="home" /><span>Go to Home</span></a>
    </div>
</div>
