@page
@model Mattiverse.Web.Pages.Wizard.IndexModel
@{
    ViewData["Title"] = "Setup";
    var steps = 3 + 3; // welcome, addresses, 3 questions, review
}

<form method="post" class="wizard" data-wizard>
    <div class="wizard__steps" aria-hidden="true">
        @for (var i = 0; i < steps; i++)
        {
            <span class="wizard__dot"></span>
        }
    </div>

    <div asp-validation-summary="ModelOnly" class="mat-validation"></div>

    @* ---------------------------------------------------------------- 1. welcome *@
    <section class="wizard__panel" data-step>
        <div class="wizard__hero">
            <img src="~/img/logo.svg" width="96" height="96" alt="" />
            <h1>@(Model.AlreadyCompleted ? "Set up Mattiverse again" : "Welcome to Mattiverse")</h1>
            <p>
                Mattiverse installs, updates and backs up your Docker apps, and connects them: a reverse proxy for domains and HTTPS,
                a DynDNS client for your changing home IP, and a Docker manager for the rest. Three questions, then it does the work.
            </p>
        </div>

        <div class="card" style="max-width:560px;margin:0 auto;">
            <div class="card__body">
                <ul class="check-list">
                    @if (Model.Engine.Available)
                    {
                        <li><span class="ok"><icon name="check-circle" /></span><span>Docker @Model.Engine.Version is connected (@Model.Engine.ContainersRunning containers running)</span></li>
                    }
                    else
                    {
                        <li><span class="bad"><icon name="x-circle" /></span><span>Docker is not reachable: @Model.Engine.Error</span></li>
                    }
                    <li><span class="ok"><icon name="check-circle" /></span><span>Your data lives in one volume and is easy to back up</span></li>
                </ul>
            </div>
        </div>

        <div class="wizard__nav">
            <span class="mat-buttons__spacer"></span>
            <button type="button" class="mat-btn mat-btn--primary" data-next><span>Let's go</span><icon name="chevron-right" /></button>
        </div>
    </section>

    @* ---------------------------------------------------------------- 2. addresses *@
    <section class="wizard__panel" data-step>
        <div class="wizard__hero">
            <h1>Where do your apps live?</h1>
            <p>Both are optional. You can change them later in the settings.</p>
        </div>

        <div class="card" style="max-width:640px;margin:0 auto;">
            <div class="card__body">
                <div class="mat-form">
                    <mat-field label="Address of this machine" asp-for="PublicHost" hint="How you reach this host from your devices, like nas.local or 192.168.1.20.">
                        <input asp-for="PublicHost" class="mat-input" placeholder="nas.local" />
                    </mat-field>
                    <mat-field label="Domain for your apps" asp-for="BaseDomain" hint="With a reverse proxy, every app gets its own address below this domain, like mail.example.com. Leave empty to use ports.">
                        <input asp-for="BaseDomain" class="mat-input" placeholder="example.com" />
                    </mat-field>
                </div>
            </div>
        </div>

        <div class="wizard__nav">
            <button type="button" class="mat-btn mat-btn--ghost" data-prev><icon name="chevron-left" /><span>Back</span></button>
            <span class="mat-buttons__spacer"></span>
            <button type="button" class="mat-btn mat-btn--primary" data-next><span>Next</span><icon name="chevron-right" /></button>
        </div>
    </section>

    @* ---------------------------------------------------------------- 3-5. the three questions *@
    @foreach (var question in Model.Questions)
    {
        <section class="wizard__panel" data-step>
            <div class="wizard__hero">
                <h1>Which @question.Title.ToLowerInvariant()?</h1>
                <p>@question.Description</p>
            </div>

            <div class="choice-grid">
                @foreach (var choice in question.Choices)
                {
                    var app = choice.App;
                    <label class="choice">
                        <input type="radio" name="@question.Field" value="@app.Id" checked="@(question.Selected == app.Id)" />
                        <app-icon name="@app.Name" icon="@app.Icon" size="lg" />
                        <span class="choice__body">
                            <span class="choice__title"><span>@app.Name</span>
                                @if (choice.Installed is not null) { <span class="pill pill--online">Installed</span> }
                                else if (app.Recommended) { <span class="mat-badge">Recommended</span> }
                            </span>
                            <span class="choice__text">@app.Tagline</span>
                            @foreach (var conflict in choice.Conflicts)
                            {
                                <span class="choice__text" style="color:var(--warning);">Port @conflict.Port is used by <code>@conflict.Container</code>.</span>
                            }
                        </span>
                        <span class="choice__check"><icon name="check" /></span>
                    </label>
                }

                <label class="choice">
                    <input type="radio" name="@question.Field" value="" checked="@(string.IsNullOrEmpty(question.Selected))" />
                    <span class="app-icon app-icon--lg" style="display:grid;place-items:center;font-size:1.7rem;color:var(--text-muted);"><icon name="x" /></span>
                    <span class="choice__body">
                        <span class="choice__title"><span>None</span></span>
                        <span class="choice__text">I already have one, or I do not need it.</span>
                    </span>
                    <span class="choice__check"><icon name="check" /></span>
                </label>
            </div>

            <div class="wizard__nav">
                <button type="button" class="mat-btn mat-btn--ghost" data-prev><icon name="chevron-left" /><span>Back</span></button>
                <span class="mat-buttons__spacer"></span>
                <button type="button" class="mat-btn mat-btn--primary" data-next><span>Next</span><icon name="chevron-right" /></button>
            </div>
        </section>
    }

    @* ---------------------------------------------------------------- 6. review *@
    <section class="wizard__panel" data-step>
        <div class="wizard__hero">
            <h1>Ready to go</h1>
            <p>This is what Mattiverse will do. Passwords are generated and shown on the app's page afterwards.</p>
        </div>

        <div class="card" style="max-width:640px;margin:0 auto;">
            <div class="card__body">
                <dl class="kv" data-wizard-summary></dl>
            </div>
        </div>

        <div class="wizard__nav">
            <button type="button" class="mat-btn mat-btn--ghost" data-prev><icon name="chevron-left" /><span>Back</span></button>
            <span class="mat-buttons__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--primary"><icon name="rocket" /><span>Install and finish</span></button>
        </div>
    </section>
</form>
