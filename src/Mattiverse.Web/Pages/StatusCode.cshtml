@page "/StatusCode/{code:int?}"
@model Mattiverse.Web.Pages.StatusCodeModel
@{
    Layout = "_Bare";
    ViewData["Title"] = Model.Title;
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>@Model.Title</h1>
        <p class="mat-muted">@Model.Message</p>
    </div>
    <a href="/" class="mat-btn mat-btn--primary mat-btn--block"><icon name="home" /><span>Back to Home</span></a>
</div>
