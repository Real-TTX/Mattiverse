@page "/StatusCode/{code:int?}"
@model Mattiverse.Web.Pages.StatusCodeModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="card" style="max-width:520px;margin:40px auto;">
    <div class="card__body" style="text-align:center;">
        <div style="font-size:2.4rem;color:var(--accent);"><icon name="compass" /></div>
        <h1>@Model.Title</h1>
        <p class="text-muted">@Model.Message</p>
        <a href="/" class="mat-btn mat-btn--primary"><icon name="home" /><span>Back to Home</span></a>
    </div>
</div>
