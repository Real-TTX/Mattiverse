@page
@model Mattiverse.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = "_Launcher";
    var isAdmin = User.IsAdmin();

    // The badge on the corner of an app: nothing while it runs; otherwise an icon that tells the state together with its colour.
    string? BadgeIcon(string css) => css switch
    {
        "online" => null,
        "warn" => "alert",
        "offline" => "x",
        "busy" => "refresh",
        _ => "pause",
    };

    // An engine as an app: it opens its own window in Mattiverse (the engines do not allow a frame); its own pages are in its menu (a new tab).
    IHtmlContent EngineApp(IndexModel.EngineTile en)
    {
        var row = en.Row;
        var state = en.Status?.Text ?? "Not installed";
        var badge = en.Status is null ? "plus" : BadgeIcon(en.Status.Css);
        var badgeCss = en.Status is null ? "os-badge" : "os-badge os-badge--" + en.Status.Css;
        var details = row.App is null ? string.Empty : $" data-details=\"/Apps/Details?id={row.App.Id}\"";
        var tab = row.OpenUrl is null ? string.Empty : $" data-tab=\"{Ui.Encode(row.OpenUrl)}\"";
        var icon = string.IsNullOrEmpty(row.Catalog.Icon) ? string.Empty : $"<img src=\"/img/apps/{Ui.Encode(row.Catalog.Icon)}\" alt=\"\" />";
        return new HtmlString(
            $"<a class=\"os-app{(row.App is null ? " os-app--absent" : string.Empty)}\" href=\"{row.Window}\" data-window=\"{row.Window}\"{tab}{details} data-title=\"{Ui.Encode(row.Catalog.Name)}\" data-name=\"{Ui.Encode(row.Catalog.Name.ToLowerInvariant())}\" title=\"{Ui.Encode(row.Catalog.Name)} · {Ui.Encode(state)}\">" +
            $"<span class=\"os-app__icon\"><span class=\"mv-appicon\" aria-hidden=\"true\">{icon}</span>" +
            (badge is null ? string.Empty : $"<span class=\"{badgeCss}\">{Ui.Icon(badge)}</span>") +
            $"</span><span class=\"os-app__label\">{Ui.Encode(row.Catalog.Name)}</span><span class=\"mat-sr-only\">{Ui.Encode(state)}</span></a>");
    }
}
@* The home screen of Mattiverse OS (layout _Launcher): widgets of glass, the apps as icons, search and dock at the bottom.
   data-window: the page that opens in the window; an installed app opens in a new tab (target=_blank) unless the person chose the window in its menu. *@

<div class="os-grid" @(Model.Busy ? "data-autorefresh=4000" : "")>
    <section class="os-widget os-w2x2 os-today" aria-label="Today" data-widget>
        <span class="os-today__day" data-os-clock="weekday"></span>
        <span class="os-today__time" data-os-clock="time">--:--</span>
        <span class="os-today__sub" data-os-clock="date"></span>
        <h1 data-os-greeting="@User.GetDisplayName()">Hello, @User.GetDisplayName()</h1>
    </section>

    @if (Model.Engines.Count > 0)
    {
        @* The engines at a glance: the programs Mattiverse runs on. Each row opens its window. *@
        <section class="os-widget os-w2x2 os-engines" aria-label="Engines" data-widget>
            <span class="os-widget__head">@Ui.Icon("layers")Engines</span>
            <div class="os-engines__list">
                @foreach (var en in Model.Engines)
                {
                    var css = en.Status?.Css ?? "absent";
                    <a class="os-engine" href="@en.Row.Window" data-window="@en.Row.Window" data-title="@en.Row.Catalog.Name">
                        <app-icon name="@en.Row.Catalog.Name" icon="@en.Row.Catalog.Icon" size="sm" />
                        <span class="os-engine__name">@en.Row.Catalog.Name</span>
                        <span class="os-engine__state os-engine__state--@css">@(en.Status?.Text ?? "Not installed")</span>
                    </a>
                }
            </div>
        </section>
    }

    <a class="os-widget os-w2" href="/Apps" data-window="/Apps" data-title="Apps" data-widget>
        <span class="os-widget__head">@Ui.Icon("apps")Apps</span>
        <span class="os-widget__value">@Model.Running<small> / @Model.Tiles.Count</small></span>
        <span class="os-widget__note">running</span>
    </a>
    @if (isAdmin)
    {
        <a class="os-widget os-w2 @(Model.BackupNeedsLook ? "os-widget--warn" : "")" href="/Backups" data-window="/Backups" data-title="Backups" data-widget>
            <span class="os-widget__head">@Ui.Icon("save")Backups</span>
            <span class="os-widget__value">@(Model.LastBackup is { } last ? Format.Ago(last) : "Never")</span>
            <span class="os-widget__note">@(Model.LastBackup is null ? "Back up your apps" : Model.BackupNeedsLook ? "Time for a new one" : "The newest one")</span>
        </a>
        <a class="os-widget os-w2" href="/Jobs" data-window="/Jobs" data-title="Activity" data-widget>
            <span class="os-widget__head">@Ui.Icon("activity")Activity</span>
            <span class="os-widget__value">@(Model.ActiveJobs == 0 ? "All quiet" : $"{Model.ActiveJobs} running")</span>
            <span class="os-widget__note">@(Model.ActiveJobs == 0 ? "Nothing is running" : Model.ActiveJobs == 1 ? "A task is running" : "Tasks are running")</span>
        </a>
    }
    @if (Model.Engine.Available)
    {
        <div class="os-widget os-w2" data-widget>
            <span class="os-widget__head">@Ui.Icon("whale")Docker</span>
            <span class="os-widget__value">@Model.Engine.ContainersRunning<small> containers</small></span>
            <span class="os-widget__note">Docker @Model.Engine.Version</span>
        </div>
    }
    else
    {
        <div class="os-widget os-w2 os-widget--warn" role="alert" data-widget>
            <span class="os-widget__head">@Ui.Icon("alert")Docker</span>
            <span class="os-widget__value">Not reachable</span>
            <span class="os-widget__note">Mount /var/run/docker.sock into the container</span>
        </div>
    }
    @if (isAdmin && !Model.Config.WizardCompleted)
    {
        <a class="os-widget os-w2 os-widget--warn" href="/Wizard" data-window="/Wizard" data-title="Setup" data-widget>
            <span class="os-widget__head">@Ui.Icon("sparkles")Setup</span>
            <span class="os-widget__value">Not set up yet</span>
            <span class="os-widget__note">Install the engines and give your apps a domain</span>
        </a>
    }
    @if (Model.Tiles.Count == 0)
    {
        if (isAdmin)
        {
            <a class="os-widget os-w2" href="/Store" data-window="/Store" data-title="Store" data-widget>
                <span class="os-widget__head">@Ui.Icon("rocket")Get started</span>
                <span class="os-widget__value">Install an app</span>
                <span class="os-widget__note">The store has your Mat apps and more</span>
            </a>
        }
        else
        {
            <div class="os-widget os-w2" data-widget>
                <span class="os-widget__head">@Ui.Icon("apps")No apps yet</span>
                <span class="os-widget__note">Ask an administrator to install some.</span>
            </div>
        }
    }

    @foreach (var tile in Model.Tiles)
    {
        var badge = BadgeIcon(tile.Status.Css);
        <a class="os-app" href="@(tile.Tab ?? tile.Window)" @(tile.Tab is not null ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)
           data-window="@tile.Window" data-tab="@tile.Tab" data-details="@tile.Details" data-manage="@(isAdmin ? $"/Apps/Manage?id={tile.App.Id}" : null)"
           data-title="@tile.App.Name" data-name="@tile.App.Name.ToLowerInvariant()" data-app-key="app-@tile.App.Id" title="@tile.App.Name · @tile.Status.Text">
            <span class="os-app__icon">
                <app-icon name="@tile.App.Name" icon="@Model.IconOf(tile.App)" />
                @if (badge is not null)
                {
                    <span class="os-badge os-badge--@tile.Status.Css">@Ui.Icon(badge)</span>
                }
            </span>
            <span class="os-app__label">@tile.App.Name</span>
            <span class="mat-sr-only">@tile.Status.Text</span>
        </a>
    }

    @foreach (var app in Model.SystemApps)
    {
        <a class="os-app" href="@app.Href" data-window="@app.Href" data-title="@app.Name" data-name="@app.Name.ToLowerInvariant()">
            <span class="os-app__icon">
                <span class="os-ico @app.Look" aria-hidden="true">@Ui.Icon(app.Icon)</span>
                @if (app.Count is { } count)
                {
                    <span class="os-count">@count<span class="mat-sr-only"> @app.CountLabel</span></span>
                }
            </span>
            <span class="os-app__label">@app.Name</span>
        </a>
    }

    @if (Model.Engines.Count > 0)
    {
        <button type="button" class="os-app os-folderbtn" data-os-folder="os-folder-system" aria-haspopup="dialog" data-name="system engines @string.Join(' ', Model.Engines.Select(en => en.Row.Catalog.Name.ToLowerInvariant()))">
            <span class="os-app__icon os-folderbtn__icon" aria-hidden="true">
                @foreach (var en in Model.Engines)
                {
                    <app-icon name="@en.Row.Catalog.Name" icon="@en.Row.Catalog.Icon" size="sm" />
                }
            </span>
            <span class="os-app__label">System</span>
        </button>
    }
</div>

@if (Model.Engines.Count > 0)
{
    @* The folder System: the engines as apps, like a folder of a phone. *@
    <div class="os-folder" id="os-folder-system" role="dialog" aria-label="System" hidden>
        <div class="os-folder__panel">
            <h2 class="os-folder__title">System</h2>
            <div class="os-folder__grid">
                @foreach (var en in Model.Engines)
                {
                    @EngineApp(en)
                }
                <a class="os-app" href="/Settings/Engines" data-window="/Settings/Engines" data-title="Engines" data-name="engines">
                    <span class="os-app__icon"><span class="os-ico os-ico--settings" aria-hidden="true">@Ui.Icon("layers")</span></span>
                    <span class="os-app__label">All engines</span>
                </a>
            </div>
        </div>
    </div>
}

<div class="os-bottom">
    <label class="os-search">
        @Ui.Icon("search")
        <input type="search" id="home-find" placeholder="Search" data-os-search aria-label="Search apps" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
    </label>
    <nav class="os-dock" aria-label="Dock">
        @foreach (var app in Model.Dock)
        {
            <a class="os-dock__app" href="@app.Href" data-window="@app.Href" data-title="@app.Name" aria-label="@app.Name" data-tip="@app.Name">
                <span class="os-ico @app.Look" aria-hidden="true">@Ui.Icon(app.Icon)</span>
            </a>
        }
    </nav>
</div>
