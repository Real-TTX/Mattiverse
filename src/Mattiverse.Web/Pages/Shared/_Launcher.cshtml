@inject Mattiverse.Core.Configuration.SystemConfigService ConfigSvc
@inject Mattiverse.Core.Jobs.JobService JobSvc
@inject Toolkit Toolkit
@using Mattiverse.Core.Users
@{
    // Mattiverse OS: the home screen is a small operating system, not a page of the toolkit (the owner's choice, docs/ARCHITECTURE.md "The home screen").
    // A status bar, the wallpaper of the account, the page (widgets, apps, dock) and ONE window: the pages of Mattiverse open in it (an iframe), with the toolkit
    // inside as everywhere (js/window-mode.js). Its look is css/os.css, its behaviour js/os.js. The page draws its own head (one h1, in the first widget).
    ViewData["Os"] = true;
    var config = await ConfigSvc.GetAsync(Context.RequestAborted);
    var name = config.InstanceName;
    var title = ViewData["Title"] as string ?? name;
    var isAdmin = User.IsAdmin();
    var activeJobs = isAdmin ? await JobSvc.CountActiveAsync(Context.RequestAborted) : 0;
    var displayName = User.GetDisplayName();
    var role = User.GetRole().ToString();
    var theme = User.GetTheme();
    var wallpaper = User.GetWallpaper();
    var darkWall = Wallpapers.All.FirstOrDefault(w => w.Id == wallpaper)?.Dark == true;

    var flash = TempData["StatusMessage"] as string;
    var flashIsError = TempData["IsError"] is true;
}
<!DOCTYPE html>
<html lang="en" data-app="@Ui.App.Id" data-os="@name" @(theme is "light" or "dark" ? Html.Raw($"data-theme=\"{theme}\"") : null)>
<partial name="_Head" model="@(string.IsNullOrEmpty(title) || title == name ? name : $"{title} · {name}")" />
<body class="os @(darkWall ? "os-desktop--dark-wall" : "")">
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)

    @* The status bar stays above everything, also above the window (like the menu bar of a Mac). *@
    <header class="os-status">
            <a class="os-status__brand" href="/" aria-label="@name, home screen"><img src="/img/logo.svg" alt="" width="18" height="18" /><span>@name</span></a>
            <div class="os-status__end">
                @if (activeJobs > 0)
                {
                    <a class="os-status__btn os-status__busy" href="/Jobs" data-window="/Jobs" data-title="Activity" title="@activeJobs @(activeJobs == 1 ? "task is" : "tasks are") running">@Ui.Icon("refresh")<span>@activeJobs</span></a>
                }
                <button type="button" class="os-status__btn os-theme" data-theme-toggle data-theme-save-url="/api/theme" data-theme-state="system" aria-label="Theme: System. Click for Light." title="Theme: System. Click for Light.">
                    <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                    <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                    <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                </button>
                <button type="button" class="os-status__btn" data-os-menu="os-user-menu" aria-haspopup="menu" aria-expanded="false" aria-label="@displayName, @role" title="@displayName">
                    <span class="os-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
                </button>
                <span class="os-status__clock"><span class="os-status__date" data-os-clock="short-date"></span><span data-os-clock="time">--:--</span></span>
            </div>
    </header>

    <div class="os-desktop" data-wallpaper="@wallpaper">
        <main class="os-home" id="main">
            @if (!string.IsNullOrEmpty(flash) && flashIsError)
            {
                <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@flash</div></div>
            }
            @RenderBody()
        </main>
    </div>

    @* The one window. Red closes it, yellow goes home and keeps the app as it is (a tap on its icon brings it back), green fills the screen; on a phone the bar at the bottom goes home. *@
    <div class="os-scrim" hidden></div>
    <section class="os-window" id="os-window" role="dialog" aria-label="Window" hidden>
        <div class="os-window__bar">
            <div class="os-lights">
                <button type="button" class="os-light os-light--close" data-win-close aria-label="Close" title="Close">@Ui.Icon("x")</button>
                <button type="button" class="os-light os-light--home" data-win-home aria-label="Home screen (the app stays open)" title="Home screen (the app stays open)">@Ui.Icon("minus")</button>
                <button type="button" class="os-light os-light--max" data-win-max aria-label="Full screen" title="Full screen">@Ui.Icon("plus")</button>
            </div>
            <button type="button" class="os-wbtn" data-win-back aria-label="Back" title="Back" disabled>@Ui.Icon("chevron-left")</button>
            <div class="os-window__title"><span class="os-window__icon" data-win-icon></span><span data-win-title></span></div>
            <div class="os-window__end">
                <button type="button" class="os-wbtn" data-win-reload aria-label="Reload" title="Reload">@Ui.Icon("refresh")</button>
                <button type="button" class="os-wbtn" data-win-tab aria-label="Open in a new tab" title="Open in a new tab">@Ui.Icon("external")</button>
                <button type="button" class="os-wbtn os-wbtn--x" data-win-close aria-label="Close" title="Close">@Ui.Icon("x")</button>
            </div>
        </div>
        <iframe class="os-window__frame" name="os-window" title="Window"></iframe>
        <button type="button" class="os-homebar" data-win-home aria-label="Home screen"></button>
    </section>

    <div class="os-menu os-menu--user" id="os-user-menu" role="menu" aria-label="@displayName" hidden>
        <div class="os-menu__head">
            <span class="os-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
            <div><strong>@displayName</strong><small>@User.GetUsername() · @role</small></div>
        </div>
        <a class="os-menu__item" role="menuitem" href="/Account/Profile" data-window="/Account/Profile" data-title="Account">@Ui.Icon("user")<span>Account</span></a>
        <a class="os-menu__item" role="menuitem" href="/Account/Profile?tab=home" data-window="/Account/Profile?tab=home" data-title="Wallpaper">@Ui.Icon("image")<span>Wallpaper</span></a>
        <a class="os-menu__item" role="menuitem" href="/Account/Profile?tab=password" data-window="/Account/Profile?tab=password" data-title="Password">@Ui.Icon("key")<span>Change password</span></a>
        <div class="os-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="os-menu__item" role="menuitem">@Ui.Icon("logout")<span>Sign out</span></button>
        </form>
        <div class="os-menu__foot">@Ui.App.Name @AppVersion.Current</div>
    </div>

    @if (!string.IsNullOrEmpty(flash) && !flashIsError)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/mattiverse.js" asp-append-version="true"></script>
    <script src="~/js/os.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
