@page
@model Mattiverse.Web.Pages.Store.IndexModel
@{
    ViewData["Title"] = "Store";
    ViewData["PageSub"] = "Your Mat apps and a few more, installed with one click.";
    ViewData["Crumbs"] = Crumbs.Of(("Store", null));
    var list = Model.List;
}

<div class="mat-list">
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="store" /></span>
            <div class="mat-empty__title">Nothing matches</div>
            <p>No app matches your search. Change the search or the filter.</p>
            <a class="mat-btn mat-btn--secondary" href="/Store">Reset the tools</a>
        </div>
    }
    else
    {
        <div class="mat-gallery">
            @foreach (var app in list.Items)
            {
                var installed = Model.InstalledCounts.GetValueOrDefault(app.Id);
                <a class="mat-card mat-card--link mv-store-card" href="/Store/Install?id=@app.Id">
                    <app-icon name="@app.Name" icon="@app.Icon" size="lg" />
                    <span class="mv-store-card__body">
                        <span class="mv-store-card__name">
                            @app.Name
                            @if (app.Recommended)
                            {
                                <span class="mat-pill mat-pill--accent mat-pill--plain">Recommended</span>
                            }
                        </span>
                        <span class="mv-store-card__tagline">@app.Tagline</span>
                        <span class="mv-store-card__meta">
                            <span class="mat-pill mat-pill--plain">@app.Category</span>
                            @if (installed > 0)
                            {
                                <span class="mat-pill mat-pill--ok">Installed@(installed > 1 ? $" ×{installed}" : "")</span>
                            }
                            @if (!app.BuiltIn)
                            {
                                <span class="mat-pill mat-pill--plain">Custom</span>
                            }
                        </span>
                    </span>
                </a>
            }
        </div>
    }

    <partial name="_Pager" model="list.Pager" />

    <div class="mat-actions">
        <form method="post" asp-page-handler="Reload">
            <button type="submit" class="mat-btn mat-btn--secondary" data-tip="Pick up files you added to /data/catalog"><icon name="refresh" /><span>Reload catalog</span></button>
        </form>
    </div>
</div>

<p class="mat-muted">
    Missing an app? An app is a compose file with an <code>x-mattiverse</code> block: drop it into <code>/data/catalog</code> and reload the catalog.
</p>
