@page
@model Mattiverse.Web.Pages.Store.InstallModel
@{
    var app = Model.App!;
    ViewData["Title"] = $"Install {app.Name}";
    ViewData["OwnHead"] = true;
    ViewData["Crumbs"] = Crumbs.Of(("Store", "/Store"), ($"Install {app.Name}", null));
    ViewData["Width"] = "narrow";
    var main = app.Variables.Where(v => !v.Hidden && !v.Advanced).ToList();
    var advanced = app.Variables.Where(v => !v.Hidden && v.Advanced).ToList();
}

<div class="mat-page__head">
    <div class="mv-apphead">
        <app-icon name="@app.Name" icon="@app.Icon" size="xl" />
        <div class="mv-apphead__text">
            <h1>@app.Name</h1>
            <p class="mat-page__sub">@app.Tagline</p>
        </div>
    </div>
</div>

<div class="mat-prose">
    <p>@app.Description</p>
    @if (!string.IsNullOrEmpty(app.Homepage))
    {
        <p><a href="@app.Homepage" target="_blank" rel="noopener"><icon name="external" /> Project page</a></p>
    }
</div>

@foreach (var note in app.Notes)
{
    <div class="mat-alert mat-alert--info"><icon name="info" /><div class="mat-alert__body">@note</div></div>
}

@foreach (var conflict in Model.PortConflicts)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <div class="mat-alert__body">Host port <strong>@conflict.Port</strong> (@conflict.Protocol) is already used by the container <code>@conflict.Container</code>. The app may fail to start until that is stopped.</div>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="mat-alert mat-alert--danger" role="alert">
        <icon name="x-circle" />
        <div class="mat-alert__body">
            <strong>The app could not be installed.</strong>
            <ul class="mat-alert__list">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    </div>
}

<form method="post" class="mat-form" novalidate>
    <input type="hidden" name="Id" value="@app.Id" />
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><icon name="settings" /><span class="mat-card__title">Install @app.Name</span></div>
        <div class="mat-card__body mat-stack">
            @if (main.Count > 0)
            {
                <div class="mat-form__grid">
                    @for (var i = 0; i < main.Count; i++)
                    {
                        var variable = main[i];
                        var needed = variable.Required && !variable.Generate;
                        var label = string.IsNullOrEmpty(variable.Label) ? variable.Key : variable.Label;
                        <mat-field label="@label" for-id="var-@variable.Key" required="@needed" hint="@(variable.Help ?? (variable.Generate ? "Leave empty to generate one." : null))">
                            <input id="var-@variable.Key" name="Values[@variable.Key]"
                                   value="@(variable.IsSecret ? "" : Model.Values.GetValueOrDefault(variable.Key) ?? variable.Default)"
                                   type="@(variable.IsSecret ? "password" : variable.Type == "number" ? "number" : "text")"
                                   class="mat-input"
                                   autocomplete="@(variable.IsSecret ? "new-password" : "off")"
                                   required="@needed" data-msg-required="Please enter @label." />
                        </mat-field>
                    }
                </div>
            }
            else
            {
                <p class="mat-muted">Nothing to configure: the defaults are fine. You can change everything later.</p>
            }

            <details class="mat-collapse">
                <summary>Advanced<icon name="chevron-down" class="mat-accordion__chev" /></summary>
                <div class="mat-accordion__body">
                    <div class="mat-form__grid">
                        <mat-field label="Display name" for-id="install-name" hint="Shown on the home screen. Leave empty for the default.">
                            <input id="install-name" name="Name" value="@Model.Name" class="mat-input" placeholder="@app.Name" />
                        </mat-field>
                        @foreach (var variable in advanced)
                        {
                            <mat-field label="@(string.IsNullOrEmpty(variable.Label) ? variable.Key : variable.Label)" for-id="var-@variable.Key" hint="@variable.Help">
                                <input id="var-@variable.Key" name="Values[@variable.Key]"
                                       value="@(variable.IsSecret ? "" : Model.Values.GetValueOrDefault(variable.Key) ?? variable.Default)"
                                       type="@(variable.IsSecret ? "password" : variable.Type == "number" ? "number" : "text")"
                                       class="mat-input" autocomplete="off" />
                            </mat-field>
                        }
                    </div>
                </div>
            </details>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="download" /><span>Install</span></button>
        <a href="/Store" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
    </div>
</form>
