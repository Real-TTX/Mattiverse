@page "/s/{token}"
@model Mattiverse.Web.Pages.Share.ViewModel
@{
    ViewData["Title"] = Model.App.Name;
}

<div class="login">
    <div class="login__brand">
        <img src="~/img/logo.svg" alt="Mattiverse" style="width:48px;height:48px;border-radius:14px;" />
        <span class="tagline">Shared with you</span>
    </div>

    <div class="card">
        <div class="card__body share-card">
            <app-icon name="@Model.App.Name" icon="@Model.Icon" size="xl" />
            <h1>@Model.App.Name</h1>
            @if (Model.OpenUrl is not null)
            {
                <p class="text-muted">Open the app to continue.</p>
                <a href="@Model.OpenUrl" class="mat-btn mat-btn--primary"><icon name="external" /><span>Open @Model.App.Name</span></a>
            }
            else
            {
                <p class="text-muted">This app has no web page.</p>
            }
        </div>
    </div>
</div>
