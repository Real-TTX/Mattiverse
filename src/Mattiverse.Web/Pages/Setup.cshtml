@page
@model Mattiverse.Web.Pages.SetupModel
@{
    Layout = "_Bare";
    ViewData["Title"] = "Welcome";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Welcome to Mattiverse</h1>
        <p class="mat-muted">Create the administrator account to get started.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.ErrorMessage</div></div>
    }

    <form method="post" class="mat-form" novalidate>
        <partial name="_ValidationSummary" />

        <mat-field label="Username" asp-for="Input.Username" required="true">
            <input asp-for="Input.Username" class="mat-input" autocomplete="username" autofocus required data-msg-required="Please choose a username." />
        </mat-field>
        <mat-field label="Display name" asp-for="Input.DisplayName" hint="Optional. Shown in the menu.">
            <input asp-for="Input.DisplayName" class="mat-input" autocomplete="name" />
        </mat-field>
        <mat-field label="Password" asp-for="Input.Password" required="true" hint="At least 8 characters.">
            <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" required minlength="8" data-msg-required="Please choose a password." data-msg-range="Use at least 8 characters." />
        </mat-field>
        <mat-field label="Confirm password" asp-for="Input.ConfirmPassword" required="true">
            <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" required data-msg-required="Please repeat the password." />
        </mat-field>

        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block"><icon name="rocket" /><span>Create account and continue</span></button>
        </div>
    </form>
</div>
