@page
@model Mattiverse.Web.Pages.Account.LoginModel
@{
    Layout = "_Bare";
    ViewData["Title"] = "Sign in";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Mattiverse</h1>
        <p class="mat-muted">@Ui.App.Tagline</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.ErrorMessage</div></div>
    }

    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <partial name="_ValidationSummary" />

        <mat-field label="Username" asp-for="Input.Username">
            <input asp-for="Input.Username" class="mat-input" autocomplete="username" autofocus required data-msg-required="Please enter your username." />
        </mat-field>

        <mat-field label="Password" asp-for="Input.Password">
            <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="current-password" required data-msg-required="Please enter your password." />
        </mat-field>

        <label class="mat-check">
            <input asp-for="Input.RememberMe" type="checkbox" />
            <span class="mat-check__text">Stay signed in</span>
        </label>

        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block"><icon name="login" /><span>Sign in</span></button>
        </div>
    </form>
</div>
