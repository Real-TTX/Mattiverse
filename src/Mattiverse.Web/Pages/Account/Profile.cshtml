@page
@model Mattiverse.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Account";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Account</h1>
    </div>
</div>

@if (Model.MustChange)
{
    <div class="alert alert--warning"><icon name="alert" /><span>Please set your own password before you continue.</span></div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert--success"><icon name="check-circle" /><span>@Model.StatusMessage</span></div>
}

<tab-bar model="Model.Tabs" />

@if (!Model.PasswordTab)
{
    <div class="card" style="max-width:560px;">
        <div class="card__header"><icon name="user" /><span>Your account</span></div>
        <div class="card__body">
            <dl class="kv">
                <dt>Username</dt><dd>@Model.Username</dd>
                <dt>Display name</dt><dd>@Model.DisplayName</dd>
                <dt>Role</dt><dd><span class="mat-badge">@Model.Role</span></dd>
            </dl>
        </div>
    </div>
}
else
{
    <div class="card" style="max-width:560px;">
        <div class="card__header"><icon name="key" /><span>Change password</span></div>
        <div class="card__body">
            <form method="post" class="mat-form">
                <div asp-validation-summary="ModelOnly"></div>

                <mat-field label="Current password" asp-for="Input.CurrentPassword">
                    <input asp-for="Input.CurrentPassword" type="password" class="mat-input" autocomplete="current-password" />
                </mat-field>
                <mat-field label="New password" asp-for="Input.NewPassword">
                    <input asp-for="Input.NewPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                <mat-field label="Confirm new password" asp-for="Input.ConfirmPassword">
                    <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                    <a href="/Account/Profile" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                </mat-form-buttons>
            </form>
        </div>
    </div>
}
